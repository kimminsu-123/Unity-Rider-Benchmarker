<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UnityRiderBench</RootNamespace>
    <AssemblyName>unityrider-bench</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProbeScript~ 아래 스크립트는 대상 Unity 프로젝트에 주입되는 UnityEditor 코드 템플릿이다.
         UnityEditor API를 참조하므로 이 CLI 프로젝트의 컴파일 대상에서 제외하고, 실행 파일과 함께 배포되도록 복사만 한다. -->
    <Compile Remove="ProbeScript~\**\*.cs" />
    <None Include="ProbeScript~\**\*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
